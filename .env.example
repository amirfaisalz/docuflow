NODE_ENV=development

# PostgreSQL and Redis
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docuflow?schema=public
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=replace-with-a-secure-secret-at-least-32-chars
# Encrypts webhook signing secrets at rest. Falls back to JWT_SECRET when omitted.
WEBHOOK_ENCRYPTION_KEY=replace-with-a-separate-secret-at-least-32-chars

# Cloudinary private document storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Gemini multimodal OCR and invoice extraction
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# Optional overrides for proxy/local tests and request timeout
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=60000

# Optional; use only for a trusted document download proxy
# DOCUMENT_SOURCE_BASE_URL=

# Application URLs
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# Optional runtime tuning. Both the API and worker read PORT, so only set it
# when starting a single service; `pnpm dev` uses 4000 (API) and 4001 (worker).
# PORT=4000
# WORKER_CONCURRENCY=2
# WEBHOOK_CONCURRENCY=5
# PROCESSING_QUEUE_NAME=document-processing

# Optional OpenTelemetry tracing; enabled when an OTLP endpoint is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SDK_DISABLED=false
