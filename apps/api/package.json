{
  "name": "@docuflow/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "PROCESSING_QUEUE_NAME=${PROCESSING_QUEUE_NAME:-docuflow-api-test} JWT_SECRET=${JWT_SECRET:-docuflow-local-test-secret-change-me-32chars} DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/docuflow?schema=public} tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@docuflow/database": "workspace:*",
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@prisma/client": "^6.19.0",
    "bullmq": "^6.7.6",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6"
  }
}
