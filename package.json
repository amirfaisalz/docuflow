{
  "name": "docuflow-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test --continue",
    "db:generate": "pnpm --filter @docuflow/database db:generate",
    "db:migrate": "pnpm --filter @docuflow/database db:migrate",
    "db:studio": "pnpm --filter @docuflow/database db:studio"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
